#!/bin/sh

if [ -d "$1" ]
then
	if [ -x /usr/bin/dircolors -o -x /usr/local/bin/dircolors ]
	then
		eval `dircolors -b "$HOME/.dir_colors"`
		exec ls --color=force -lF "$1"
	else
		CLICOLOR=1 CLICOLOR_FORCE=1 exec ls -lF "$1"
	fi
else
	case $1 in
		*.json)
			if command -v jq > /dev/null 2>&1
			then
				exec jq -C . "$1"
			fi;;
	esac
fi

exit 1
