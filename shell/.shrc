#! sh

# Default keys as emacs style
set -o emacs
# Do not overwrite files with redirected outputs
set -o noclobber

# If linux console set a timeout of 1 hour
[ "$TERM" != linux ] || TMOUT=3600

gethostname() {
	if [ -n "$COMPUTERNAME" ]
	then
		# Windows
		echo "$COMPUTERNAME"
	elif [ -r /proc/sys/kernel/hostname ]
	then
		cat /proc/sys/kernel/hostname
	else
		hostname | cut -d. -f1
	fi
}

hostname=`gethostname`

# Change terminal window title
if [ -t 1 ]
then
	# Set XON/XOFF flow control
	[ ! -x /bin/stty ] || stty -ixon

	if [ -x /usr/bin/tty -o -x /usr/local/bin/tty ]
	then
		# Get TTY name and number
		tty=`tty 2> /dev/null | sed -e 's,^/dev/,,'`
		# Codes:
		# \033    (ESC)    Escape
		# \033]   (ESC ])  Operating System Controls (OSC)
		# \033]1; (OSC 1;) Change Icon Name
		# \033k   (ESC k)  Change title string
		# \033\\  (ESC \)  String terminator
		case "$TERM" in
			screen*|tmux*)
				[ "$STY" -o "$TMUX" ] || h=$hostname
				printf '\033]1;%s@%s\a' "$tty" "$hostname"
				[ -n "$TMUX" ] || printf '\033k%s@%s\033\\' "$tty" "$h"
				unset h;;
			xterm*|rxvt*|ansi*)
				printf '\033]1;%s@%s\a' "$tty" "$hostname";;
		esac
		unset tty h
	fi
fi

# Set prompt different for root
if [ -z "$PS1" ]
then
	[ "`id | sed -e 's/^uid=\([0-9]*\).*$/\1/'`" -eq 0 ] && PS1='# ' || PS1='$ '
fi
case $PS1 in
	?' ') PS1="$LOGNAME@$hostname `basename "$0" | sed -e 's/^-//'` $PS1";;
esac

unset hostname

if command -v pacman > /dev/null 2>&1
then
	# remove unused build files in aur-sync cache
	aur_gc()
	(
		XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
		AURDEST=${AURDEST:-$XDG_CACHE_HOME/aurutils/sync}

		# Assumes build files were retrieved through git(1)
		find "$AURDEST" -name .git -execdir git clean -xf \;

		# Print directories which do not contain a PKGBUILD file
		for d in "$AURDEST"/*
		do
			[ -f "$d/PKGBUILD" ] || printf '%s\n' "$d"
		done
	)

	# remove listed packages from all local repositories
	aur_remove()
	(
		# `return`, not `exit`: an `exit` here used to close the
		# interactive shell (now harmless in a subshell, but clearer).
		if [ "$#" -eq 0 ]
		then
			printf 'usage: aur_remove package [package ...]\n' >&2
			return 1
		fi

		aur repo --path-list | while read -r repo_path
		do
			repo-remove "$repo_path" "$@"
			paccache -c "${repo_path%/*}" -rvk0 "$@"
		done
	)

	# show the most recently installed packages (default: 20)
	pacman_last()
	(
		expac --timefmt='%Y-%m-%d %T' '%l\t%n' | sort | tail -n "${1:-20}"
	)

	alias aur_check='aur repo -d aur --list | aur vercmp'
	alias aur_list='comm -12 <(pacman -Qq | sort) <(pacman -Sql aur | sort)'
	alias aur_unused='comm -13 <(pacman -Qq | sort) <(pacman -Sql aur | sort)'
fi

# Aliases
alias cls='clear'
alias cp='cp -i'
alias dcm2nii='dcm2niix -v n -z y -f '"'"'%s_%p'"'"
alias gst='git status'
alias gsti='git status --ignored'
alias j='jobs'
alias ll='ls -l'
alias mv='mv -i'
alias rsync='rsync --exclude-from="$HOME/.cvsignore"'
alias tree='tree -C'
alias vi="${VISUAL:-vi}"

if [ "`uname -s`" = Darwin ]
then
	alias d='ls -lah'
	alias o='open'
else
	alias d='ls -lah --group-directories-first'
	alias diff='diff --color=auto'
	alias o='xdg-open'
	alias ip='ip -color=auto'
fi

if [ -x /usr/bin/dircolors -o -x /usr/local/bin/dircolors ]
then
	# Linux coloring
	eval `dircolors -b "$HOME/.dir_colors"`
	# Convert bold to bright colors
	case "$TERM" in
		xterm*|screen*|tmux*) LS_COLORS=`echo "$LS_COLORS" | sed -e 's/01;3/00;9/g'`;;
	esac
	alias ls='ls -hF --color=auto'
else
	# BSD coloring
	alias ls='CLICOLOR=1 ls -hF'
fi

if ! grep --color 2>&1 | grep un > /dev/null
then
	alias grep='grep --color=auto --exclude=".*.swp" --exclude="*~" --exclude=tags'
fi

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
if command -v osascript > /dev/null 2>&1 || command -v notify-send > /dev/null 2>&1
then
	_alert_notify()
	{
		if command -v osascript > /dev/null 2>&1
		then
			# Pass the text as argv so it is never parsed as AppleScript
			if [ "$1" = 0 ]
			then
				set -- 'Command finished' "$2"
			else
				set -- "Command failed ($1)" "$2"
			fi
			osascript -e 'on run argv' \
				-e 'display notification (item 2 of argv) with title (item 1 of argv)' \
				-e 'end run' "$1" "$2"
		else
			if [ "$1" = 0 ]
			then
				notify-send --urgency=low -i terminal "$2"
			else
				notify-send --urgency=low -i error "$2"
			fi
		fi
	}
	alias alert='_alert_notify "$?" "$(history | tail -n 1 | sed -e '"'"'s/^[[:space:]]*[0-9]*[[:space:]]*//; s/[;&|][[:space:]]*alert$//'"'"')"'
fi

# Alias commands in tiago script
for cmd in `$HOME/.local/bin/tiago aliases`
do
	alias $cmd="\"\$HOME\"/.local/bin/tiago $cmd"
done
unset cmd

# Source local shrc file if it exists
[ ! -r "$HOME/.shrc.local" ] || . "$HOME/.shrc.local"
